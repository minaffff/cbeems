rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPublished() {
      return resource.data.status == 'published';
    }

    match /lessons/{lessonId} {
      allow read: if isPublished();
      allow write: if false;
    }

    match /mediaAssets/{assetId} {
      allow read: if isPublished();
      allow write: if false;
    }

    match /pages/{pageId} {
      allow read: if resource.data.status in ['published', 'reserved'];
      allow write: if false;
    }

    match /siteSettings/global {
      allow read: if true;
      allow write: if false;
    }

    match /supportLinks/{supportLinkId} {
      allow read: if isPublished();
      allow write: if false;
    }

    match /contactSubmissions/{submissionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
